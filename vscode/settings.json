{
  "[astro]": {
    "editor.defaultFormatter": "astro-build.astro-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[json][jsonc][javascript][yaml][javascriptreact][typescript][typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[markdown]": {
    "editor.acceptSuggestionOnEnter": "off",
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnPaste": false,
    "editor.parameterHints.enabled": false,
    "editor.quickSuggestions": {
      "comments": "off",
      "other": "off",
      "strings": "off"
    },
    "editor.renderWhitespace": "all",
    "editor.snippetSuggestions": "none",
    "files.trimTrailingWhitespace": false
  },
  "[mdx]": {
    "editor.defaultFormatter": "unifiedjs.vscode-mdx"
  },
  "application.shellEnvironmentResolutionTimeout": 40,
  "chat.viewSessions.orientation": "stacked",
  "claudeCode.preferredLocation": "panel",
  "debug.allowBreakpointsEverywhere": true,
  "debug.toolBarLocation": "docked",
  "diffEditor.codeLens": true,
  "diffEditor.experimental.useTrueInlineView": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": true,
  "editor.acceptSuggestionOnCommitCharacter": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.fontFamily": "Cascadia Code",
  "editor.fontLigatures": true,
  "editor.fontSize": 16,
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "modifications",
  "editor.formatOnType": true,
  "editor.guides.bracketPairs": true,
  "editor.insertSpaces": true,
  "editor.matchBrackets": "always",
  "editor.maxTokenizationLineLength": 40000,
  "editor.minimap.enabled": false,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.quickSuggestions": {
    "comments": false,
    "other": true,
    "strings": true
  },
  "editor.renderControlCharacters": false,
  "editor.renderWhitespace": "all",
  "editor.semanticHighlighting.enabled": true,
  "editor.suggest.insertMode": "replace",
  "editor.suggestOnTriggerCharacters": true,
  "editor.tabSize": 2,
  "editor.trimAutoWhitespace": false,
  "editor.wordSeparators": "`~!@#$%^&*()=+[{]}\\|;:'\",.<>/?",
  "explorer.autoReveal": true,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    ".env": "*.env, .env.*, .envrc, env.d.ts",
    ".gitignore": ".gitattributes, .gitmodules, .gitmessage, .mailmap, .git-blame*",
    "*.css": "$(capture).css.map, $(capture).*.css",
    "*.js": "$(capture).js.map, $(capture).min.js, $(capture).d.ts",
    "*.jsx": "$(capture).js",
    "*.ts": "$(capture).js, $(capture).*.ts",
    "*.tsx": "$(capture).ts",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, prettier.config.*, prettierrc.*,.eslintrc.*,eslint.config.*,.lintstagedrc.*,.eslintignore, .gitattributes, .editorconfig, .commitlintrc.*, .eslintcache,.gitignore,.npmrc,.prettierignore,.yarnrc.yml,turbo.json,jest.config.*,pnpm-workspace.yaml,plopfile.*,tsconfig.*,biome.json,lefthook.yml,oxlint.config.*, oxfmt.config.*",
    "readme*": "authors, backers*, changelog*, citation*, code_of_conduct*, codeowners, contributing*, contributors, copying, credits, governance.md, history.md, license*, maintainers, readme*, security.md, sponsors*, ecosystem*",
    "tsconfig.json": "tsconfig.*.json"
  },
  "files.associations": {
    "*.mdx": "mdx"
  },
  "files.trimTrailingWhitespace": true,
  "git.autofetch": true,
  "git.blame.statusBarItem.enabled": true,
  "git.mergeEditor": true,
  "gitProjectManager.baseProjectsFolders": [
    "~/Workspaces"
  ],
  "gitProjectManager.checkRemoteOrigin": false,
  "gitProjectManager.ignoredFolders": [
    "node_modules"
  ],
  "gitProjectManager.storeRepositoriesBetweenSessions": true,
  "html.format.enable": true,
  "html.format.indentHandlebars": true,
  "html.format.maxPreserveNewLines": 0,
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "js/ts.suggest.autoImports": true,
  "js/ts.suggestionActions.enabled": true,
  "js/ts.tsserver.experimental.enableProjectDiagnostics": true,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "json.schemaDownload.trustedDomains": {
    "https://turbo.build/schema.json": true,
    "https://ui.shadcn.com/schema.json": true
  },
  "screencastMode.fontSize": 30,
  "screencastMode.keyboardOptions": {
    "showKeys": false
  },
  "search.searchEditor.defaultNumberOfContextLines": 2,
  "telemetry.telemetryLevel": "off",
  "terminal.external.osxExec": "Ghostty.app",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.fontFamily": "Cascadia Code PL",
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.inheritEnv": false,
  "terminal.integrated.shellIntegration.enabled": false,
  "terminal.integrated.tabs.enabled": false,
  "window.autoDetectHighContrast": false,
  "window.commandCenter": true,
  "window.nativeTabs": true,
  "window.title": "${rootNameShort}",
  "workbench.colorCustomizations": {
    "[Aura Dark]": {
      "activityBar.activeBackground": "#0b0b0c",
      "editor.background": "#0b0b0c",
      "editorGroupHeader.tabsBackground": "#110f17",
      // will underline the entire word with dots in your chosen color
      "editorHint.border": "#00ff66",
      // will change the color of three dots to red
      "editorHint.foreground": "#ff0000",
      "sideBar.background": "#0b0b0c",
      "sideBar.border": "#38296e",
      "statusBar.background": "#0b0b0c",
      "tab.activeBorderTop": "#bdaefa",
      "tab.inactiveBackground": "#110f17",
      "terminal.background": "#0b0b0c"
    },
    "[One Dark Pro]": {
      "tab.activeBorderTop": "#0A84FF"
    }
  },
  "workbench.colorTheme": "Aura Dark",
  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.enablePreview": false,
  "workbench.editor.enablePreviewFromQuickOpen": false,
  "workbench.fontAliasing": "default",
  "workbench.iconTheme": "symbols",
  "workbench.sideBar.location": "right",
  "workbench.tree.enableStickyScroll": true
}