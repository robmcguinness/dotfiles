{
  "[astro]": {
    "editor.defaultFormatter": "astro-build.astro-vscode"
  },
  "[json][jsonc][javascript][yaml][javascriptreact][typescript][typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[markdown]": {
    "editor.acceptSuggestionOnEnter": "off",
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnPaste": false,
    "editor.parameterHints.enabled": false,
    "editor.quickSuggestions": {
      "comments": "off",
      "other": "off",
      "strings": "off"
    },
    "editor.renderWhitespace": "all",
    "editor.snippetSuggestions": "none",
    "files.trimTrailingWhitespace": false
  },
  "application.shellEnvironmentResolutionTimeout": 40,
  "biome.suggestInstallingGlobally": false,
  "cSpell.numSuggestions": 0,
  "cSpell.textDecoration": "underline wavy #fc9867 auto",
  "chat.agent.maxRequests": 500,
  "chat.mcp.discovery.enabled": true,
  "debug.allowBreakpointsEverywhere": true,
  "debug.toolBarLocation": "docked",
  "diffEditor.codeLens": true,
  "diffEditor.experimental.useTrueInlineView": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.bracketPairColorization.enabled": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit",
    "source.organizeImports.biome": "explicit"
  },
  // "typescript.inlayHints.parameterNames.enabled": "all",
  "editor.fontFamily": "Cascadia Code",
  "editor.fontLigatures": true,
  "editor.fontSize": 16,
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "modifications",
  "editor.formatOnType": true,
  "editor.guides.bracketPairs": true,
  "editor.insertSpaces": true,
  "editor.matchBrackets": "always",
  "editor.maxTokenizationLineLength": 40000,
  "editor.minimap.enabled": false,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.quickSuggestions": {
    "comments": false,
    "other": true,
    "strings": true
  },
  "editor.renderControlCharacters": false,
  "editor.renderWhitespace": "all",
  "editor.semanticHighlighting.enabled": true,
  "editor.suggestOnTriggerCharacters": true,
  "editor.tabSize": 2,
  "editor.trimAutoWhitespace": false,
  "editor.wordSeparators": "`~!@#$%^&*()=+[{]}\\|;:'\",.<>/?",
  "explorer.autoReveal": true,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.css": "$(capture).css.map, $(capture).*.css",
    "*.js": "$(capture).js.map, $(capture).min.js, $(capture).d.ts",
    "*.jsx": "$(capture).js",
    "*.ts": "$(capture).js, $(capture).*.ts",
    "*.tsx": "$(capture).ts",
    ".env": "*.env, .env.*, .envrc, env.d.ts",
    ".gitignore": ".gitattributes, .gitmodules, .gitmessage, .mailmap, .git-blame*",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, prettier.config.*, prettierrc.*,.eslintrc.*,eslint.config.*,.lintstagedrc.*,.eslintignore, .gitattributes, .editorconfig, .commitlintrc.*, .eslintcache,.gitignore,.npmrc,.prettierignore,.yarnrc.yml,turbo.json,jest.config.*,pnpm-workspace.yaml,plopfile.*,tsconfig.*,biome.json,lefthook.yml",
    "readme*": "authors, backers*, changelog*, citation*, code_of_conduct*, codeowners, contributing*, contributors, copying, credits, governance.md, history.md, license*, maintainers, readme*, security.md, sponsors*, ecosystem*",
    "tsconfig.json": "tsconfig.*.json"
  },
  "files.associations": {
    "*.mdx": "mdx"
  },
  "files.exclude": {
    "**/.classpath": true,
    "**/.factorypath": true,
    "**/.project": true,
    "**/.settings": true,
    "dist/": false,
    "lib/": false,
    "node_modules/": false
  },
  "files.trimTrailingWhitespace": true,
  "git.autofetch": true,
  "git.blame.statusBarItem.enabled": true,
  "git.mergeEditor": true,
  "gitProjectManager.baseProjectsFolders": [
    "~/Workspaces"
  ],
  "gitProjectManager.checkRemoteOrigin": false,
  "gitProjectManager.ignoredFolders": [
    "node_modules"
  ],
  "gitProjectManager.storeRepositoriesBetweenSessions": true,
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "text": "Follow the conventional commit message format. Limit the first line to 72 characters or less."
    }
  ],
  "github.copilot.nextEditSuggestions.fixes": false,
  "html.format.enable": true,
  "html.format.indentHandlebars": true,
  "html.format.maxPreserveNewLines": 0,
  "javascript.suggestionActions.enabled": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "npm-intellisense.packageSubfoldersIntellisense": true,
  "npm-intellisense.scanDevDependencies": true,
  "screencastMode.fontSize": 30,
  "screencastMode.keyboardOptions": {
    "showKeys": false
  },
  // "screencastMode.keyboardOverlayTimeout": 900,
  // "search.mode": "reuseEditor",
  "search.searchEditor.defaultNumberOfContextLines": 2,
  "telemetry.telemetryLevel": "off",
  "terminal.external.osxExec": "iTerm.app",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.defaultProfile.osx": "fish",
  "terminal.integrated.fontFamily": "Cascadia Code PL",
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.inheritEnv": false,
  "terminal.integrated.profiles.osx": {
    "fish": {
      "path": "${env:HOME}/Dev/homebrew/bin/fish"
    }
  },
  "terminal.integrated.tabs.enabled": false,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "window.autoDetectHighContrast": false,
  "window.commandCenter": true,
  "window.nativeTabs": true,
  "workbench.colorCustomizations": {
    "[Aura Dark]": {
      "activityBar.activeBackground": "#0b0b0c",
      "editor.background": "#0b0b0c",
      "editorGroupHeader.tabsBackground": "#110f17",
      // will underline the entire word with dots in your chosen color
      "editorHint.border": "#00ff66",
      // will change the color of three dots to red
      "editorHint.foreground": "#ff0000",
      "sideBar.background": "#0b0b0c",
      "sideBar.border": "#38296e",
      "statusBar.background": "#0b0b0c",
      "tab.activeBorderTop": "#bdaefa",
      "tab.inactiveBackground": "#110f17",
      "terminal.background": "#0b0b0c"
    },
    "[One Dark Pro]": {
      "tab.activeBorderTop": "#0A84FF"
    }
  },
  "workbench.colorTheme": "Aura Dark",
  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.enablePreview": false,
  "workbench.editor.enablePreviewFromQuickOpen": false,
  "workbench.fontAliasing": "default",
  "workbench.iconTheme": "vs-seti",
  "workbench.sideBar.location": "right",
  "workbench.tree.enableStickyScroll": true
}